# Run npm run setup to generate a unique local reviewer key in ignored .env.
# Production builds omit VITE_API_KEY; use the runtime connection screen.
# Local VITE_API_KEY is a convenience visible in the browser, not personal identity.
API_KEY=
VITE_API_KEY=
BACKEND_PORT=8001
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Defaults persist under .data/ at the repository root (ignored by Git).
# DATABASE_URL=sqlite:///./.data/fdr.db
# STORAGE_DIR=./.data/documents
MAX_UPLOAD_MB=10
MAX_DOCUMENT_PAGES=30

# Deterministic review rules. Amounts are decimal strings; no currency conversion.
MINIMUM_AMOUNT=10000
DEFAULT_CURRENCY=INR
REMINDER_DAYS=30
REQUIRED_FIELDS=instrument_number,bank_name,amount,currency,issue_date,maturity_date,holder_name
# Comma-separated rule IDs, for example MINIMUM_AMOUNT. Use carefully.
DISABLED_RULES=

# demo = labelled text parser; never claims live AI ran.
# gemma = explicit OpenAI-compatible inference adapter, with no silent fallback.
EXTRACTION_MODE=demo
GEMMA_BASE_URL=
GEMMA_MODEL=
GEMMA_API_KEY=
GEMMA_TIMEOUT_SECONDS=180
# Constrain JSON structure; use json_object only for older compatible runtimes.
GEMMA_RESPONSE_FORMAT=json_schema
GEMMA_MAX_TOKENS=1600
GEMMA_REPAIR_ATTEMPTS=1
GEMMA_SUPPORTS_VISION=false
# Optional bounded local CPU profiles: see docs/gemma.md and docs/inference-ocr.md.
# Run setup-inference.py --model gemma|qwen, then npm run model:select -- gemma|qwen.
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_PROFILE=qwen
# To select Gemma explicitly after download: npm run model:select -- gemma
# GEMMA_BASE_URL=http://127.0.0.1:8081/v1
# GEMMA_MODEL=qwen2.5-0.5b-instruct
# EXTRACTION_MODE=gemma
# Example for a separately installed Ollama runtime (verify with ollama list):
# GEMMA_BASE_URL=http://127.0.0.1:11434/v1
# GEMMA_MODEL=gemma4:e2b
# GEMMA_API_KEY=ollama

# CPU ONNX OCR is included in the backend requirements. Paddle remains optional.
OCR_ENABLED=true
OCR_ENGINE=rapidocr
OCR_DPI=200

# Optional Llama Prompt Guard 2. Disabled by default; no automatic model download.
# Weights require separate Meta access/license acceptance and an authorized HF cache.
PROMPT_GUARD_ENABLED=false
PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-22M
PROMPT_GUARD_THRESHOLD=0.5
PROMPT_GUARD_DEVICE=cpu
PROMPT_GUARD_MAX_CHUNKS=64
# PROMPT_GUARD_CACHE_DIR=C:/path/to/huggingface/hub

# Authenticated, predefined checks run against disposable synthetic data.
SECURITY_LAB_ENABLED=true

# Total time allowed to receive a body, plus per-process abuse protection.
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
